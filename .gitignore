# =============================================================================
# .gitignore — JR Validated Environment
# =============================================================================
# NOTE: .Rprofile is intentionally NOT excluded — its contents are deliberate
#       (disables renv auto-activation) and must be version controlled.
# NOTE: .gitignore and .github/ are intentionally NOT excluded.
# NOTE: project_id.txt is intentionally NOT excluded — must be committed so
#       all team members get the correct project identity on clone.
# =============================================================================

# -----------------------------------------------------------------------------
# macOS system files
# -----------------------------------------------------------------------------
.DS_Store
**/.DS_Store
.Spotlight-V100
.Trashes
.fseventsd
.AppleDouble
.LSOverride

# -----------------------------------------------------------------------------
# R / renv auto-generated files
# -----------------------------------------------------------------------------
.Rhistory
**/.Rhistory
.RData
**/.RData
.Rapp.history
**/.Rapp.history

# renv internals — machine-specific, regenerated automatically
renv/
**/renv/

# renv.lock is generated locally by admin_install_R from R_requirements.txt
# and r_version.txt — it is not distributed via git to avoid merge conflicts
# when users run different R versions or add packages locally.
admin/renv.lock

# Auto-generated validation scripts — do not edit manually
# Regenerated by admin_validate via generate_validate_R.zsh
admin/R/validate_R_env.R
admin/Python/validate_Python_env.py

# Plain-text OQ validation report — superseded by OQ_validation_report.docx
docs/OQ_validation_report_20260315.txt

# Local archive folder — not for version control
docs/ignore/

# Module doc generators and source docs (PDFs committed, sources ignored)
repos/msa/docs/ignore/
repos/spc/docs/ignore/
repos/as/docs/ignore/
repos/corr/docs/ignore/
repos/cap/docs/ignore/
repos/curve/docs/ignore/
repos/shelf_life/docs/ignore/
repos/rdt/docs/ignore/

# -----------------------------------------------------------------------------
# Python auto-generated files
# -----------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.python-version

# -----------------------------------------------------------------------------
# Admin / machine-specific generated files
# -----------------------------------------------------------------------------
# Integrity file is generated per machine by admin_create_hash
admin/project_integrity.sha256

# Package-hash manifests are per-machine/per-platform — regenerated locally from
# the install's own package repos by admin_create_hash / admin_install, and
# covered by project_integrity.sha256. Not shipped (they would not match another
# install's repo).
admin/python_package_hashes.sha256
admin/r_package_hashes.sha256

# -----------------------------------------------------------------------------
# Package repositories
# -----------------------------------------------------------------------------
# These are large binary folders managed via Dropbox, not Git
R_repo/
Python_repo/

# -----------------------------------------------------------------------------
# Build output
# -----------------------------------------------------------------------------
build/*.pkg
build/*.dmg

# -----------------------------------------------------------------------------
# pytest cache
# -----------------------------------------------------------------------------
.pytest_cache/
**/.pytest_cache/

# -----------------------------------------------------------------------------
# Website — kept local, not published via Git
# -----------------------------------------------------------------------------
web/

# -----------------------------------------------------------------------------
# Validation Pack — paid-only, must not be distributed via GitHub
# -----------------------------------------------------------------------------
pack/
docs/templates/verify_attr_report_template.html
docs/templates/dv_report_template.html
docs/templates/pv_report_template.html

# -----------------------------------------------------------------------------
# Personal / local notes and internal tooling — not for version control
# -----------------------------------------------------------------------------
MANUAL-notes.md
CLAUDE.md
SCRIPT_IDEAS.md
INFRA_BACKLOG.md
docs/*.py
docs/oq_validation_plan.md

# -----------------------------------------------------------------------------
# Microsoft Office temporary lock files
# -----------------------------------------------------------------------------
~$*

# -----------------------------------------------------------------------------
# GUI admin config — local only, contains password hash
# -----------------------------------------------------------------------------
app/.admin_config.json

# -----------------------------------------------------------------------------
# Editor and IDE files
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
Rplots.pdf
session_log.txt
tools/proforma_invoice_template.docx
tools/receipt_template.docx
tools/delivery_email_template.html
tools/generate_invoice_template.py

# -----------------------------------------------------------------------------
# Owner-only / local working files — never commit to the public repo.
# Guards against an accidental `git add -A` (see the v4.1.1 near-miss).
# -----------------------------------------------------------------------------
.claude/
*.zip

# Sales / business (owner-only)
/competitor_landscape.md
/customer_upgrade_plan.md
/linkedin_kfactor_post.md

# Local planning, session & draft docs (root)
/security_web_update_plan.md
/session_curve_properties.md
/shelf_life_release_plan.md
/learning_path_plan.md
/rdt_module_plan.md
/new_module_plan_template.md
/clinical_module_plan.html
/draft_article_sample_size_design_verification.md
/*_DRAFT.html
/*we-are-extending-the-work-on-jr-anchored*.txt

# Generated test artifacts / scratch data
/oq/data/*_value_verification_report.html
/repos/*/oq/data/*_value_verification_report.html
/repos/*/oq/data/*_value_tolerance.png
/repos/msa/oq/data/nested_grr_crossed.csv
/repos/spc/docs/spc_validation_plan.docx
