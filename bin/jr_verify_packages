#!/bin/bash
#
# jr_verify_packages <repo_dir> <manifest> [label]
#
# Verify every file listed in the recorded SHA256 <manifest> exists in
# <repo_dir> and matches. Hard-fail (exit 1) on any MISSING or MODIFIED file —
# this is what stops a swapped package in the Dropbox/SMB repo from being
# installed. If the manifest does not exist yet, skip with an advisory note
# (exit 0) so installs keep working until manifests are generated.
#
# Called before every environment (re)build: from bin/jrrun (both languages)
# and from admin_install_R / admin_install_Python (INSTALL mode).
#
set -uo pipefail

REPO="${1:?usage: jr_verify_packages <repo_dir> <manifest> [label]}"
MANIFEST="${2:?usage: jr_verify_packages <repo_dir> <manifest> [label]}"
LABEL="${3:-package}"

if [[ ! -f "$MANIFEST" ]]; then
  echo "ℹ️  No $LABEL hash manifest yet — skipping package content verification."
  exit 0
fi
if [[ ! -d "$REPO" ]]; then
  echo "❌ $LABEL repo not found: $REPO"
  exit 1
fi

# Single-pass check: shasum -c hashes every listed file in one process (the same
# mechanism jrrun uses for the project integrity file) — far faster than one
# process per file. Manifest paths are relative, so run from inside the repo.
MANIFEST_ABS="$(cd "$(dirname "$MANIFEST")" && pwd)/$(basename "$MANIFEST")"
n="$(wc -l < "$MANIFEST_ABS" | tr -d '[:space:]')"

echo "🔍 Verifying $LABEL repository against recorded hashes ($n files)..."

# shasum -c prints "<file>: OK" per file and "<file>: FAILED" / "No such file"
# on a mismatch, setting a non-zero status. We discard the OK lines on success
# and show only the failures on error — so no reliance on a --quiet flag that
# some shasum builds (e.g. Git Bash) may not support.
if out="$(cd "$REPO" && shasum -a 256 -c "$MANIFEST_ABS" 2>&1)"; then
  echo "✅ $LABEL packages verified ($n files match the manifest)."
  exit 0
fi

echo "$out" | grep -vE ': OK$' | sed 's/^/   /'
echo ""
echo "❌ $LABEL package repository integrity FAILED."
echo "   The file(s) above do not match the recorded hash manifest — a"
echo "   package may have been swapped or corrupted. Aborting before install."
echo "   Contact your administrator."
exit 1
