#!/bin/bash
set -e
#
# parameter: none
#
#
# Create a hash file from folder contents

# --- Script directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# --- Move to project root (relative paths in the manifest are anchored here)
cd "$PROJECT_ROOT" || exit 1

# --- Shared canonical file list (kept in sync with bin/jrrun)
# shellcheck source=bin/jr_integrity_files.sh
source "$PROJECT_ROOT/bin/jr_integrity_files.sh"

show_help() {
  echo ""
  echo "Usage: admin_create_hash"
  echo ""
  echo "  Use only allowed by admin!"
  echo "  Provision to check tampering with folder"
  echo "  -h| --help  Show this help message"
  echo ""
  echo "Example:"
  echo "  admin_create_hash  "
  exit 0
}


# Check for help argument
for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    show_help
  fi
done

# --- Re-anchor the package-hash manifests to THIS machine's local repos.
# The manifests are per-machine/per-platform (the file set and binaries differ
# between installs), so they are regenerated locally here rather than shipped.
# Done before hashing so project_integrity.sha256 covers the fresh manifests.
# Skipped for a repo that is not present (e.g. Dropbox not synced yet).
_py_repo="$PROJECT_ROOT/Python_repo/my-repo"
_r_repo="$PROJECT_ROOT/R_repo/my-cran-repo"
if [[ -d "$_py_repo" ]]; then
  "$PROJECT_ROOT/bin/jr_hash_packages" "$_py_repo" "$SCRIPT_DIR/python_package_hashes.sha256" \
    || echo "⚠️  Could not regenerate Python package manifest (continuing)."
fi
if [[ -d "$_r_repo" ]]; then
  "$PROJECT_ROOT/bin/jr_hash_packages" "$_r_repo" "$SCRIPT_DIR/r_package_hashes.sha256" \
    || echo "⚠️  Could not regenerate R package manifest (continuing)."
fi

echo "Creating master integrity hash..."

jr_integrity_hash_list | sort -u | while IFS= read -r file; do
    if [[ -f "$file" ]]; then
        shasum -a 256 "$file"
    fi
done | sort > "$SCRIPT_DIR/project_integrity.sha256"

_count=$(wc -l < "$SCRIPT_DIR/project_integrity.sha256" | tr -d '[:space:]')
echo "✅ Integrity file created ($_count files covered)."

