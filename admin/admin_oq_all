#!/bin/bash
#
# admin_oq_all — Run all OQ test suites: core/community (admin_oq) plus
#                every module admin_*_oq found under repos/*/
#
# Usage: admin_oq_all
#
# Runs each suite in sequence. Prints a pass/fail summary at the end.
# Exits non-zero if any suite failed.
#
# Author: Joep Rous
# Version: 1.0

set -uo pipefail

# ---------------------------------------------------------------------------
# Resolve paths
# ---------------------------------------------------------------------------

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
REPOS_DIR="$PROJECT_ROOT/repos"

# Needed for the per-run output folder: jr_oq_output_summary lives in
# jr_platform.sh, and the folder is keyed by project id. The suites resolve
# both for themselves; this script has to as well because it mints the run id
# and reports the folder once the whole run is done.
source "$PROJECT_ROOT/bin/jr_platform.sh"

PROJECT_ID_FILE="$SCRIPT_DIR/project_id.txt"
if [[ ! -f "$PROJECT_ID_FILE" ]]; then
  echo "❌ project_id.txt not found. Contact your administrator."
  exit 1
fi
PROJECT_ID="$(tr -d '[:space:]' < "$PROJECT_ID_FILE")"

# ---------------------------------------------------------------------------
# Discover suites
# ---------------------------------------------------------------------------

# Core/community suite always runs first
SUITES=("$SCRIPT_DIR/admin_oq")

# Discover module admin_*oq scripts using bash glob rather than `find`.
# Rationale: when this script is invoked via "bash --login" from the GUI on
# Windows, the login profile may prepend C:\Windows\System32 to PATH, causing
# `find` to resolve to Windows find.exe (a string-in-file tool, not a
# filesystem searcher). Using bash's native glob expansion avoids PATH lookup
# entirely and works identically on macOS, Windows Git Bash, and Linux.
_raw_modules=()
for _module_dir in "$REPOS_DIR"/*/; do
  [[ -d "$_module_dir" ]] || continue
  for _script in "$_module_dir"admin_*oq; do
    [[ -f "$_script" ]] || continue
    [[ "$(basename "$_script")" == "admin_oq_validate" ]] && continue
    _raw_modules+=("$_script")
  done
done
if [[ ${#_raw_modules[@]} -gt 0 ]]; then
  while IFS= read -r _s; do
    [[ -n "$_s" ]] && SUITES+=("$_s")
  done < <(printf "%s\n" "${_raw_modules[@]}" | sort)
fi

# ---------------------------------------------------------------------------
# Print plan
# ---------------------------------------------------------------------------

echo " "
echo "JR Validated Environment — Full OQ Run"
echo "======================================="
echo "Suites to run: ${#SUITES[@]}"
for s in "${SUITES[@]}"; do
  echo "  $(basename "$(dirname "$s")")/$(basename "$s")"
done
echo " "

# ---------------------------------------------------------------------------
# Run each suite and collect results
# ---------------------------------------------------------------------------

# Force UTF-8 I/O so pytest can print emoji from script output on Windows.
export PYTHONUTF8=1

# One output folder for the WHOLE run: every suite below inherits this id, so
# all ten write into the same ~/.jrscript/<PROJECT_ID>/oq_output/<id>/ folder.
export JR_OQ_RUN_ID="$(date '+%Y%m%dT%H%M%S')"

declare -a RESULTS_NAME
declare -a RESULTS_EXIT

for suite in "${SUITES[@]}"; do
  if [[ ! -f "$suite" ]]; then
    echo "⚠️  Skipping (not found): $suite"
    RESULTS_NAME+=("$(basename "$suite")")
    RESULTS_EXIT+=(2)
    continue
  fi

  label="$(basename "$(dirname "$suite")")/$(basename "$suite")"
  echo "-----------------------------------------------------------"
  echo "▶  $label"
  echo "-----------------------------------------------------------"

  # Run via bash explicitly — avoids NTFS execute-bit issues on Windows.
  # No || true: set -e is not active here, so the script continues on failure,
  # and $? correctly captures the suite's exit code.
  bash "$suite"
  exit_code=$?

  RESULTS_NAME+=("$label")
  RESULTS_EXIT+=("$exit_code")
  echo " "
done

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

echo "==========================================================="
echo "OQ ALL — SUMMARY"
echo "==========================================================="

overall=0
for i in "${!RESULTS_NAME[@]}"; do
  code="${RESULTS_EXIT[$i]}"
  if [[ "$code" -eq 0 ]]; then
    status="✅ PASS"
  elif [[ "$code" -eq 2 ]]; then
    status="⚠️  SKIP"
    overall=1
  else
    status="❌ FAIL"
    overall=1
  fi
  printf "  %-45s %s\n" "${RESULTS_NAME[$i]}" "$status"
done

echo "-----------------------------------------------------------"
if [[ "$overall" -eq 0 ]]; then
  echo "✅ All OQ suites PASSED."
else
  echo "❌ One or more OQ suites FAILED or were skipped."
fi
echo " "

jr_oq_output_summary "$PROJECT_ID" "$HOME/.jrscript/$PROJECT_ID/oq_output/$JR_OQ_RUN_ID"
echo " "

exit "$overall"
